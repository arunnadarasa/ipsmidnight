pragma language_version 0.23;
import CompactStandardLibrary;

// Public ledger: append-only registry of patient-summary commitments.
// No clinical content, no digest, no patient identity is ever written here —
// only a salted commitment plus a per-record author commitment.
export ledger anchor_count: Counter;
export ledger last_commitment: Bytes<32>;
export ledger last_author: Bytes<32>;
export ledger commitments: Set<Bytes<32>>;

// Private input supplied by the caller's local wallet; never leaves the device.
witness localSecretKey(): Bytes<32>;

constructor() {
  anchor_count.increment(1);
}

// Insert-only: a new key per anchor. Updating an existing public map key
// panics the dust fee balancer on the second call against the same wallet.
export circuit anchorSummary(commitment: Bytes<32>): [] {
  const sk = localSecretKey();
  const seq = anchor_count as Field as Bytes<32>;
  const author = persistentHash<Vector<3, Bytes<32>>>([pad(32, "ips:anchor:v1"), seq, sk]);

  last_commitment = disclose(commitment);
  last_author = disclose(author);
  commitments.insert(disclose(commitment));
  anchor_count.increment(1);
}
